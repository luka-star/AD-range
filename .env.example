# Copy this file to `.env` and set the paths/secrets for THIS machine.

# ---- Absolute paths on this machine -------------------------------------------------------------
# Your ctf-gameserver checkout (the gameserver image is built from it):
GAMESERVER_SRC=/home/youruser/ctf-gameserver
# FakeBook's checkers (the gameserver runs these against the vulnboxes):
CHECKERS_DIR=/home/youruser/FakeBook/checkers

# ---- Game settings ------------------------------------------------------------------------------
# Base64 secret shared by the checkers and the submission server.
#   generate with:  head -c 24 /dev/urandom | base64
CTF_FLAGSECRET=
# Tick length in seconds.
SIM_TICK_DURATION=60
# Admin password for the gameserver web /admin (username: admin).
WEB_ADMIN_PASSWORD=admin
