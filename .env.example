# Copy this file to `.env` and adjust the paths to match your machine.
# `make up` reads it automatically.

# ---- Absolute paths on your Mac (no trailing slash) ---------------------------------------------
# Your ctf-gameserver source checkout (built into the gameserver image):
GAMESERVER_SRC=/Users/lukas/ctf-gameserver
# The GIFaway service, checkers and exploits:
GIFAWAY_DIST=/Users/lukas/Desktop/Example Services/GIFaway/dist
CHECKERS_DIR=/Users/lukas/Desktop/Example Services/GIFaway/checkers
EXPLOITS_DIR=/Users/lukas/Desktop/Example Services/GIFaway/exploits

# ---- Game settings ------------------------------------------------------------------------------
# Base64 secret shared by the checkers and the submission server (any valid base64 string).
CTF_FLAGSECRET=c2ltLXJhbmdlLXNlY3JldA==
# Tick length in seconds (short for a lively local demo; real events use 60-180).
SIM_TICK_DURATION=60
# Admin password for the gameserver web /admin (username: admin).
WEB_ADMIN_PASSWORD=admin
