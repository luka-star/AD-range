#!/usr/bin/env bash
# Runner for the GIFaway local A/D range (equivalent to the Makefile).
# Usage: ./range <command>
#   keys        Generate WireGuard keys + configs (once)
#   core        Build + start the gameserver, vulnboxes and gateway
#   up          Build + start the whole range
#   logs        Follow all logs
#   scoreboard  Open the scoreboard in your browser
#   teams-json  Print current flag IDs (what attackers read)
#   down        Stop the range (keep data)
#   clean       Stop the range and delete all volumes
set -euo pipefail
cd "$(dirname "$0")"
C="docker compose"

ensure_env()  { [ -f .env ] || { cp .env.example .env; echo "Created .env from .env.example - edit paths if needed"; }; }
# Read GAMESERVER_SRC without `source`-ing .env (paths may contain spaces). Compose reads the rest of
# .env itself for ${...} interpolation.
load_env()    { GAMESERVER_SRC=$(grep -E '^[[:space:]]*GAMESERVER_SRC=' .env | tail -1 | cut -d= -f2- | sed 's/^"//;s/"$//'); export GAMESERVER_SRC; }
ensure_keys() { [ -f wireguard/wg0.conf ] || ./scripts/gen-wg.sh; }

# Copy your ctf-gameserver source into gameserver/_src so the image builds from one normal context
# (no special Compose features needed). Re-synced on every build so your edits are picked up.
sync_src() {
  : "${GAMESERVER_SRC:?set GAMESERVER_SRC in .env}"
  [ -d "$GAMESERVER_SRC" ] || { echo "GAMESERVER_SRC not found: $GAMESERVER_SRC"; exit 1; }
  echo "[range] syncing gameserver source -> gameserver/_src"
  mkdir -p gameserver/_src
  rsync -a --delete \
    --exclude '.git' \
    --exclude '__pycache__' \
    --exclude '*.egg-info' \
    --exclude 'build' \
    --exclude 'dist' \
    --exclude 'docs_site' \
    --exclude 'web/dev-db.sqlite3' \
    --exclude 'src/ctf_gameserver/web/static/ext' \
    "$GAMESERVER_SRC"/ gameserver/_src/
}

case "${1:-}" in
  keys)        ensure_keys ;;
  core)        ensure_env; load_env; ensure_keys; sync_src; $C up -d --build
               echo "Core up. Scoreboard: http://localhost:8000/competition/scoreboard" ;;
  up)          ensure_env; load_env; ensure_keys; sync_src
               $C up -d --build
               echo "Range up. Scoreboard: http://localhost:8000/competition/scoreboard" ;;
  logs)        $C logs -f ;;
  scoreboard)  open http://localhost:8000/competition/scoreboard 2>/dev/null || echo "http://localhost:8000/competition/scoreboard" ;;
  teams-json)  curl -s http://localhost:8000/competition/teams.json | python3 -m json.tool ;;
  down)        $C down ;;
  clean)       $C down -v ;;
  *)           grep -E '^#( |$)' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
esac
